#!name=Locket Gold Free
#!desc=By: Đỗ Quang Minh

[Script]
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/minh2703/lockcrack/refs/heads/lkgold/Locket_Gold.js, requires-body=true, max-size=-1, timeout=60

deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/minh2703/lockcrack/refs/heads/lkgold/deleteheader.js, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com
